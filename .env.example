# ==============================================================================
# TeleForge Environment Configuration Template
# Copy this file to .env and fill in your real values if configuring via environment.
# Note: .env is ignored in .gitignore and should never be committed.
# ==============================================================================

# Telegram API Credentials (Optional - can also be set in .telegram_config.json or in-app)
# Obtain your apiId and apiHash from https://my.telegram.org
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Android Release Signing (Optional - used by Gradle release task when building signed APK/AAB)
# KEYSTORE_PATH=my-upload-key.jks
# STORE_PASSWORD=
# KEY_ALIAS=upload
# KEY_PASSWORD=
