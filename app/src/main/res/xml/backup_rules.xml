<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include general application preferences -->
    <include domain="sharedpref" path="." />
    <!-- Exclude sensitive Telegram MTProto auth keys, session tokens, and local databases -->
    <exclude domain="sharedpref" path="tg_session.xml" />
    <exclude domain="sharedpref" path="teleforge_auth.xml" />
    <exclude domain="database" path="." />
    <exclude domain="no_backup" path="." />
</full-backup-content>
